# ODBC connection to the SQL Server instance hosting VECA (bi schema)
MSSQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=YOURSERVER;Database=VECA;UID=etl_bi_reader;PWD=***;TrustServerCertificate=yes

# Supabase Postgres — DIRECT / session-pooler connection, postgres role.
# Supabase Dashboard -> Settings -> Database -> Connection string (session mode)
PG_CONN=postgresql://postgres.YOURPROJECT:***@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Refuse a table load that returns fewer than this fraction of the rows the
# previous successful load had (guards against an empty/filtered source
# view wiping the warehouse). 0 disables the check for a known shrink.
ETL_MIN_ROW_RATIO=0.5
