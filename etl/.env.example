# Copy to etl/.env and fill in. On the BI server, make .env readable only by
# the account the scheduled tasks run as (and Administrators):
#   icacls .env /inheritance:r /grant:r "<DOMAIN\svc-account>:R" "Administrators:F"

# --- Connections (required) -------------------------------------------------

# ODBC connection to the SQL Server instance hosting VECA (bi schema).
# Use tcp: and the port explicitly. Without it the driver may try named
# pipes / SQL Browser first, which fails or stalls from a server that is not
# on the same subnet. Integrated auth (Trusted_Connection=yes) needs a task
# logon with network credentials: Password or gMSA, never S4U (see
# schedule/Register-CrmTasks.ps1). With S4U, use SQL auth as below.
MSSQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOURSERVER,1433;Database=VECA;UID=etl_bi_reader;PWD=***;TrustServerCertificate=yes

# Supabase Postgres, role postgres. SESSION MODE ONLY: the direct connection
# or the session pooler on port 5432. Never the transaction pooler on port
# 6543. The loader holds advisory locks and a staging table across
# transactions, so it needs one backend for the whole run. It refuses 6543
# (exit 2) and also checks that pg_backend_pid() stays the same.
# Supabase Dashboard -> Connect -> Session pooler.
PG_CONN=postgresql://postgres.YOURPROJECT:***@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- Load behaviour (optional) ------------------------------------------------

# Refuse a table load that returns fewer than this fraction of the rows the
# previous successful load had (guards against an empty/filtered source
# view wiping the warehouse). 0 disables the check for a known shrink.
ETL_MIN_ROW_RATIO=0.5

# Per-statement cap for the loader's session when the profile sets none
# (the ats profile sets 60s in views.yml). Default 15min.
#ETL_STATEMENT_TIMEOUT=15min

# Escape hatch: `replace` makes every table swap with DELETE + INSERT, as
# before the merge swap existed, whatever views.yml says.
#ETL_SWAP_MODE=replace

# work_mem for a merge swap's transaction only (SET LOCAL). Default 64MB;
# 0 = the server's (2184kB on Micro, which spills the merge's hash to disk).
#ETL_MERGE_WORK_MEM=64MB

# 1 = never call post_load_http (the AI batch); same as --no-http.
#ETL_SKIP_POST_LOAD_HTTP=1

# 1 = read each SQL Server view under SNAPSHOT isolation (autocommit, one
# consistent snapshot per view, no blocking against ERP writers). Needs the
# DBA to run ALTER DATABASE VECA SET ALLOW_SNAPSHOT_ISOLATION ON first.
# Leave unset until they have.
#ETL_MSSQL_SNAPSHOT=1

# --- AI batch (optional; post_load_http after the 04:30 full run) ------------

#SUPABASE_URL=https://YOURPROJECT.supabase.co
#AI_BATCH_SECRET=***

# --- Alerting (read by push.ps1, not the loader) ------------------------------

# Incoming webhook that accepts {"text": "..."}: Slack, or a Teams
# Workflows "post to a channel when a webhook request is received" flow.
# POSTed on a failed run (ats: from the 3rd failure in a row).
#ETL_ALERT_WEBHOOK=https://...

# healthchecks.io-style ping URLs, one check per tier. GET on success,
# GET <url>/fail on failure. Suggested periods / grace: full 1 day / 2 h,
# hourly 1 h / 30 min (weekdays 06-16), ats 15 min / 45 min (weekdays 05-18).
#ETL_HEARTBEAT_URL_FULL=https://hc-ping.com/<uuid>
#ETL_HEARTBEAT_URL_HOURLY=https://hc-ping.com/<uuid>
#ETL_HEARTBEAT_URL_ATS=https://hc-ping.com/<uuid>
